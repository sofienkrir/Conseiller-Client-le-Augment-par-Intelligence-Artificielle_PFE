GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
MONGO_URI=mongodb://localhost:27017

# Chiffrement Fernet des donnees client sensibles (telephone, date_naissance, revenus_mensuels...)
# Generer une nouvelle cle avec:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: ne jamais commiter la vraie cle — ce fichier est un exemple sans valeur reelle
ENCRYPTION_KEY=remplacer_par_une_cle_fernet_generee

# 2FA — Gmail SMTP (creer un mot de passe d'application Google)
# Compte Google -> Securite -> Validation 2 etapes -> Mots de passe d'application
GMAIL_USER=votre.compte@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# 2FA — Configuration
TWO_FA_ENABLED=true
TWO_FA_CODE_EXPIRY_MINUTES=10
TWO_FA_MAX_ATTEMPTS=5
TRUSTED_DEVICE_DAYS=30

# LLM principal (REQUIS) - Groq, endpoint compatible OpenAI
# Cle a creer sur https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Modele de secours Gemini (optionnel) - mettre false pour desactiver
USE_GEMINI=true

# URL du frontend utilisee dans les liens des e-mails
FRONTEND_URL=http://localhost:5173

# Ponderations du scoring de risque RBA (optionnel - valeurs par defaut ci-dessous)
RISK_GEO_JUMP=50
RISK_NEW_COUNTRY=35
RISK_SUSPICIOUS_UA=35
RISK_NEW_DEVICE=25
RISK_SHARED_DEVICE=25
RISK_NEW_CITY=15
RISK_UNUSUAL_HOUR=10
